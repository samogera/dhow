# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32-byte key, base64. Generate: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# ---- Supabase (Project settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Cloudflare R2 (R2 > Manage API tokens) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dhow-os-documents
# Used in the Content-Security-Policy so browsers may upload straight to R2
R2_PUBLIC_UPLOAD_ORIGIN=https://<account-id>.r2.cloudflarestorage.com

# ---- M-Pesa Daraja (developer.safaricom.co.ke) ----
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Long random string. The callback URL includes it so only Safaricom's call is accepted.
MPESA_CALLBACK_SECRET=
VERIFICATION_FEE_KES=500

# ---- KYB provider: smile_id | manual ----
KYB_PROVIDER=manual
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
SMILE_ID_ENV=sandbox

# ---- Email (resend.com) ----
RESEND_API_KEY=
EMAIL_FROM="Dhow Partners <hello@dhowpartners.com>"

# ---- SMS (africastalking.com) ----
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# ---- Google Calendar (console.cloud.google.com) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Inngest (app.inngest.com) ----
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
